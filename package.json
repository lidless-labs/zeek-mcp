{
  "name": "zeek-mcp",
  "version": "3.1.2",
  "description": "MCP server for Zeek network analysis framework - query and analyze Zeek logs via AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zeekctrl": "dist/cli.js",
    "zeekctl": "dist/cli.js",
    "zeek-mcp": "dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/mcp-bin.ts",
    "start": "node dist/mcp-bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "generate-logs": "tsx scripts/generate-zeek-logs.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Solomon Neas <me@solomonneas.dev>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "undici": "^7.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "hono": "4.12.27",
    "esbuild": "0.28.1"
  },
  "packageManager": "npm@10.9.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidless-labs/zeek-mcp.git"
  },
  "homepage": "https://github.com/lidless-labs/zeek-mcp#readme",
  "bugs": {
    "url": "https://github.com/lidless-labs/zeek-mcp/issues"
  }
}
